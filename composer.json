{
    "name": "kurama/framework",
    "description": "Kurama - a lightweight, standalone PHP micro router.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Kurama\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kurama\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
