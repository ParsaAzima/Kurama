{
    "name": "kurama/framework",
    "description": "Kurama - a lightweight, standalone PHP micro router.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Kurama\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kurama\\Tests\\": "tests/",
            "Kurama\\Examples\\": "examples/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8000 -t public public/index.php",
        "bench": "php examples/benchmark.php",
        "console": "php bin/kurama"
    },
    "config": {
        "sort-packages": true
    }
}
